# exe.dev hosts are excluded: the account there is chosen by which key we
# offer, and IdentityFile accumulates across stanzas — injecting the default
# keys here would override the per-account keys set in ~/.ssh/config.
Host * !exe.dev !exe2389 !*.exe.xyz
    UseKeychain yes
    IdentitiesOnly yes
    IdentityFile ~/.ssh/id_rsa
    IdentityFile ~/.ssh/id_ed25519
